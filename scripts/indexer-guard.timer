[Unit]
Description=Check for a Cloudflare-banned VPN exit IP every 15 minutes

[Timer]
# Monotonic timers only, and deliberately not OnBootSec.
#
# Same trap queue-cleanup.timer was caught by and backlog-search.timer
# documents: OnBootSec measures from the last boot, and on a NAS that has been
# up for weeks that is always in the past. A unit installed with
# `systemctl --user enable --now` would then have its first elapse already due
# and start the service in the same second the schedule was registered.
# Observed on queue-cleanup, 2026-09-13: unit registered at 23:48:19, log
# header 23:48:19. OnActiveSec measures from when the timer was activated, so
# it is the stated delay on a fresh enable and on a timer restart alike.
OnActiveSec=15min
OnUnitActiveSec=15min
Unit=indexer-guard.service

# Fifteen minutes because each pass is two local HTTP GETs and one python3 run
# over documents already in hand, and because an IP that Cloudflare has just
# banned is worth noticing within the quarter hour rather than at the next
# scheduled reconnect. It is not a rotation interval: a rotation is rate
# limited by the module's own cooldown (6 hours by default), so a banned IP
# cannot be reconnected twice in one VPN session no matter how often this
# fires. AccuracySec is left at its default -- a check a minute late costs
# nothing, and a wakeup that fires while the box is busy costs a little.

[Install]
WantedBy=timers.target
