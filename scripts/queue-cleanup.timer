[Unit]
Description=Run the arr-stack stuck-queue cleanup hourly

[Timer]
# 15min rather than 5: this one deletes from the download clients, and a boot
# is exactly when the clients are still coming up behind gluetun. The other
# two timers only read.
#
# Hourly, and that is set by the shortest staleness threshold in
# scripts/lib/queue_cleanup.py rather than by taste: a debrid-backed item is
# called dead after 3 hours of no progress, and a sweep that runs less often
# than the threshold it enforces leaves dead items sitting for the difference.
# tests/systemd-units.bats derives both numbers and fails if this one is ever
# the slower of the two.
OnBootSec=15min
OnUnitActiveSec=1h
Unit=queue-cleanup.service

[Install]
WantedBy=timers.target
