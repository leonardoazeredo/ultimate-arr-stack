[Unit]
Description=Run the arr-stack stuck-queue cleanup hourly

[Timer]
# Monotonic timers only, and deliberately not OnBootSec.
#
# OnBootSec measures from the last boot, and on a NAS that has been up for
# weeks that is always in the past. So the 15 minutes it looked like it bought
# did not exist: `systemctl --user enable --now queue-cleanup.timer` on an
# already-running system registered a timer whose first elapse was due
# immediately, and the service started the same second. Observed 2026-09-13 --
# unit registered at 23:48:19, log header 23:48:19, "Summary (APPLIED): 16
# items removed, 7 searches triggered". That is a destructive sweep fired by
# the act of installing the schedule, which is not what a 15-minute grace
# period means. OnActiveSec measures from when the timer was activated, so it
# is 15 minutes in every case, and it applies on a fresh enable and on a timer
# restart alike. It also gives the age gate its say: nothing under 3 hours old
# is removed regardless of when the sweep runs.
OnActiveSec=15min
OnUnitActiveSec=1h
Unit=queue-cleanup.service

[Install]
WantedBy=timers.target
